{
    "name": "recoilgear",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "build": "frida-compile src/Index.ts -o dist/agent.js -B iife",
        "format": "prettier --write src eslint.config.mjs",
        "format:check": "prettier --check src eslint.config.mjs",
        "check": "npm run typecheck && npm run lint && npm run format:check"
    },
    "prettier": {
        "printWidth": 100,
        "tabWidth": 4,
        "trailingComma": "all",
        "endOfLine": "lf"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/frida-gum": "^19.13.0",
        "eslint": "^10.14.0",
        "frida": "17.2.11",
        "frida-compile": "^19.1.0",
        "prettier": "^3.9.10",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.72.1"
    }
}
